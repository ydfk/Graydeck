{
  "name": "graydeck-workspace",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:web": "pnpm --filter graydeck-web dev",
    "dev:server": "node ./scripts/run-air.mjs",
    "build": "pnpm run build:web && pnpm run embed:web && pnpm run build:server",
    "build:web": "pnpm --filter graydeck-web build",
    "embed:web": "node ./scripts/sync-web-assets.mjs",
    "build:server": "node ./scripts/go-build.mjs",
    "build:standalone": "node ./scripts/build-standalone.mjs",
    "check": "pnpm run check:server && pnpm run check:web",
    "check:web": "pnpm --filter graydeck-web exec tsc -p tsconfig.app.json --noEmit",
    "check:server": "node ./scripts/go-build.mjs",
    "docker:build": "node ./scripts/docker-build.mjs",
    "docker:push": "node ./scripts/docker-push.mjs",
    "docker:buildPush": "node ./scripts/docker-build-push.mjs",
    "build:docker": "node ./scripts/docker-build.mjs",
    "push:docker": "node ./scripts/docker-push.mjs",
    "buildPush:docker": "node ./scripts/docker-build-push.mjs"
  }
}
